# Copy to .env for local development (never commit .env).
# Load it with: node --env-file=.env src/server.js

PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/weekship.db
APP_NAME=Weekship
SUPPORT_EMAIL=you@example.com
# Optional: slug of your own Weekship project, to show its widget on the landing page.
SELF_CHANGELOG_SLUG=

# Stripe, TEST MODE keys only (sk_test_...). The server refuses sk_live_ keys
# unless ALLOW_LIVE_STRIPE=true is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Shown on the landing and billing pages; keep in sync with the Stripe prices.
PRICE_MONTHLY_LABEL=9
PRICE_YEARLY_LABEL=90
ALLOW_LIVE_STRIPE=false

# Password reset email via Resend (https://resend.com). Without a key the
# reset link is printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Weekship <noreply@yourdomain.com>
